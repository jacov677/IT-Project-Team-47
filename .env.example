# Copy this file to .env and fill in your own values. Never commit .env.
#   Windows:     copy .env.example .env
#   Mac/Linux:   cp .env.example .env

# --- Django ---
DJANGO_DEBUG=True
# Generate a key with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (MySQL 8.0) ---
# Use DB_ENGINE=sqlite ONLY if you cannot install MySQL yet. Always test with MySQL before a pull request.
DB_ENGINE=mysql
DB_NAME=wil_placement
DB_USER=wil_app
DB_PASSWORD=change-this-password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Uploaded documents (stored outside the web root) ---
# DOCUMENT_STORAGE_PATH=C:/wil_documents
DOCUMENT_MAX_UPLOAD_MB=10

# --- Email notifications (console backend prints emails in the terminal) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
